{
  "manifest_version": 3,
  "name": "人格工作室 · 本机连接助手",
  "version": "1.3.3",
  "description": "仅在授权的本机工作室中连接当前 X 登录账号，不发布任何内容。",
  "key": "",
  "permissions": [
    "cookies",
    "storage",
    "alarms",
    "nativeMessaging",
    "scripting"
  ],
  "host_permissions": [
    "https://x.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "externally_connectable": {
    "matches": [
      "http://127.0.0.1/*",
      "http://localhost/*",
      "https://persona-studio-plaxkk.vercel.app/*"
    ]
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "打开人格工作室"
  }
}
